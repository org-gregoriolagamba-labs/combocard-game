# Backend Environment Configuration
# Copy this file to .env and update the values

# ===================
# Server Configuration
# ===================
NODE_ENV=development
PORT=3001

# ===================
# Database (PostgreSQL)
# ===================
# Connection string. Without it the server keeps data in memory and loses it on restart.
# Matches the database started by `docker compose up -d` from the repository root.
# DATABASE_URL=postgresql://combocard:combocard@localhost:5432/combocard
# Maximum connections in the pool (default: 10)
# DATABASE_POOL_MAX=10

# ===================
# Authentication
# ===================
# Required in production, at least 32 characters: openssl rand -hex 48
# Outside production a random value is generated at each start.
# JWT_SECRET=
# Access token duration in seconds (default: 15 minutes)
# ACCESS_TOKEN_TTL_SECONDS=900
# Refresh token duration in days (default: 7)
# REFRESH_TOKEN_TTL_DAYS=7
# Seconds in which an already replaced refresh token is still accepted
# REFRESH_REUSE_GRACE_SECONDS=10
# Send the refresh cookie only over HTTPS (default: true in production)
# COOKIE_SECURE=true
# Cookie SameSite policy: use none only with frontend and backend on different domains
# COOKIE_SAMESITE=strict
# Number of reverse proxies in front of the server (default: 0)
# TRUST_PROXY=1

# ===================
# CORS Configuration
# ===================
# Frontend URL for CORS (use comma-separated values for multiple origins)
CORS_ORIGIN=http://localhost:3000

# ===================
# Rate Limiting
# ===================
# Window duration in milliseconds (default: 15 minutes)
RATE_LIMIT_WINDOW_MS=900000
# Maximum requests per window and IP address, active only in production.
# A player waiting in a lobby sends 450 requests per window: players in the same
# home or office share the limit. Login and registration have separate limits.
RATE_LIMIT_MAX_REQUESTS=3000
# Disable rate limiting entirely (useful for automated tests)
# RATE_LIMIT_DISABLED=true

# ===================
# Game Configuration
# ===================
# Default credits for new players
DEFAULT_CREDITS=0
# Maximum credits per purchase
MAX_CREDITS_PER_PURCHASE=10000
# Draw cooldown in seconds
DRAW_COOLDOWN_SECONDS=8

# ===================
# Prize Distribution (percentages)
# ===================
PRIZE_TRIS=0.10
PRIZE_SEQUENZA=0.15
PRIZE_SCOPA=0.20
PRIZE_NAPOLA=0.25
PRIZE_COMBOCARD_REALE=0.30
