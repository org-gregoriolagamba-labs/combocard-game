{
  "name": "combocard-backend",
  "version": "2.4.0",
  "description": "COMBOCARD Game Backend - Express.js with Socket.IO",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "start:e2e": "cross-env RATE_LIMIT_DISABLED=true node src/server.js",
    "test": "cross-env NODE_ENV=test RATE_LIMIT_DISABLED=true node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:coverage": "cross-env NODE_ENV=test RATE_LIMIT_DISABLED=true node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "test:watch": "cross-env NODE_ENV=test RATE_LIMIT_DISABLED=true node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "db:migrate": "node src/db/migrate.cli.js",
    "admin:promote": "node src/db/admin-promote.cli.js"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "helmet": "^8.3.0",
    "joi": "^18.3.1",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.0",
    "pg": "^8.23.1",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.14.0",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "nodemon": "^3.0.3"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
